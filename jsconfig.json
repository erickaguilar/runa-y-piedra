{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "maxNodeModuleJsDepth": 0,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "vite.config.js"]
}
