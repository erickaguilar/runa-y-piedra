{
  "name": "runa-y-piedra",
  "version": "1.40.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host",
    "test": "node --test tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p jsconfig.json",
    "guards": "node scripts/guards.mjs",
    "precommit": "npm run lint && npm test",
    "prepare": "node scripts/setup-hooks.mjs",
    "ci": "npm run lint && npm test && npm run build && npm run guards"
  },
  "dependencies": {
    "nipplejs": "^0.10.1",
    "peerjs": "^1.5.2",
    "qrcode": "^1.5.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  }
}
